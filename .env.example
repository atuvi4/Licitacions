# ---------------------------------------------------------------------------
# Copia aquest fitxer a `.env` i ajusta els valors:   cp .env.example .env
#
# `.env` NO va al repositori (.gitignore l'exclou).
# Tots els valors d'aquest fitxer son de DESENVOLUPAMENT LOCAL: cap credencial
# real ha d'acabar mai versionada.
# ---------------------------------------------------------------------------

# --- General ---------------------------------------------------------------
ENVIRONMENT=local                 # local | staging | production
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# BASE DE DADES
# ---------------------------------------------------------------------------
# Hi ha dues maneres de configurar-la i DATABASE_URL sempre te prioritat:
#
#   1. Peces soltes (POSTGRES_*)  -> es el que fa servir docker compose.
#   2. DATABASE_URL sencera       -> util per a proveidors gestionats (Neon,
#      Supabase, RDS...) i per a entorns sense Docker.
#
# Amb Docker deixa DATABASE_URL comentada: el contenidor `api` es connecta a
# `db:5432` a traves de POSTGRES_HOST.
POSTGRES_USER=licitacions
POSTGRES_PASSWORD=licitacions
POSTGRES_DB=licitacions
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Port amb que s'exposa PostgreSQL a la maquina amfitriona (psql, DBeaver...).
POSTGRES_HOST_PORT=5433

# Driver obligatori: asyncpg. Exemple per a PostgreSQL fora de Docker:
# DATABASE_URL=postgresql+asyncpg://licitacions:licitacions@localhost:5433/licitacions
# En produccio amb TLS:
# DATABASE_URL=postgresql+asyncpg://usuari:clau@host:5432/base?ssl=require

# ---------------------------------------------------------------------------
# AUTENTICACIO I SESSIO
# ---------------------------------------------------------------------------
# Clau de signatura dels tokens de sessio. CANVIA-LA a qualsevol entorn que no
# sigui el teu portatil. Genera'n una amb:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production-please-use-a-long-random-value

ACCESS_TOKEN_EXPIRE_MINUTES=480   # durada de la sessio (8 h)
# Cookie amb flag Secure: ha de ser `true` en qualsevol desplegament amb HTTPS.
COOKIE_SECURE=false
# Origen del frontend per a CORS. Nomes cal si algu crida l'API directament:
# en l'arrencada normal, Next.js fa de proxy same-origin i CORS no s'utilitza.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# OBJECT STORAGE (S3-compatible)
# ---------------------------------------------------------------------------
# El backend nomes coneix la interficie StorageService: canviar de proveidor
# (MinIO, AWS S3, Cloudflare R2, Scaleway, OVH) es nomes canviar aquests valors.
STORAGE_BACKEND=s3                # s3 | local  (`local` = sistema de fitxers, nomes dev/tests)
STORAGE_BUCKET=licitacions-documents
STORAGE_ENDPOINT_URL=http://minio:9000   # buit o sense informar per a AWS S3
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
# MinIO i molts S3 europeus necessiten path-style; AWS S3 accepta `false`.
STORAGE_FORCE_PATH_STYLE=true
# Nomes s'utilitza quan STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./var/storage

# Exemples per a altres proveidors (substitueixen les tres linies de dalt):
#   AWS S3            STORAGE_ENDPOINT_URL=            STORAGE_REGION=eu-west-1
#   Cloudflare R2     STORAGE_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
#   Scaleway          STORAGE_ENDPOINT_URL=https://s3.fr-par.scw.cloud   STORAGE_REGION=fr-par
#   OVH               STORAGE_ENDPOINT_URL=https://s3.gra.io.cloud.ovh.net  STORAGE_REGION=gra

# --- MinIO (nomes desenvolupament local; credencials de joguina) -----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------------------------------------------------------------------------
# UPLOADS
# ---------------------------------------------------------------------------
# Font unica de veritat: el backend l'aplica i el frontend el llegeix per
# `GET /api/v1/config`. No el dupliquis al codi del client.
MAX_UPLOAD_SIZE_MB=25

# Dies abans de la caducitat en que una acreditacio es marca com a "caduca aviat".
EXPIRY_WARNING_DAYS=60

# ---------------------------------------------------------------------------
# SERVEIS
# ---------------------------------------------------------------------------
API_PORT=8000
WEB_PORT=3000
# URL de l'API vista des del servidor de Next.js. Dins de Docker: http://api:8000
# En mode local sense Docker: http://127.0.0.1:8000
API_INTERNAL_URL=http://api:8000

# Redis: declarat per als workers futurs (ingestio, parsing). Cap proces
# l'utilitza encara.
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# DESCÀRREGA DE PLECS DE LICITACIÓ
# ---------------------------------------------------------------------------
# Adreça que s'anuncia al User-Agent davant de PLACSP.
INGESTION_CONTACT_EMAIL=
DOCUMENT_DOWNLOAD_TIMEOUT_SECONDS=30
DOCUMENT_DOWNLOAD_TOTAL_TIMEOUT_SECONDS=120
DOCUMENT_MAX_SIZE_MB=60
DOCUMENT_MAX_REDIRECTS=5
DOCUMENT_DOWNLOAD_MAX_ATTEMPTS=3
DOCUMENT_MAX_PAGES=2000
DOCUMENT_LOW_TEXT_CHARS_PER_PAGE=100
DOCUMENT_PROCESSING_STALE_SECONDS=300
# MAI a producció: permetria descarregar de la xarxa interna (SSRF).
DOCUMENT_DOWNLOAD_ALLOW_PRIVATE_HOSTS=false

# ---------------------------------------------------------------------------
# ANÀLISI DE PLECS (IA)
# ---------------------------------------------------------------------------
# fake = proveïdor determinista, sense xarxa (el que fan servir els tests).
LLM_PROVIDER=fake
# Sense clau l'aplicació arrenca igual: només queda no disponible l'anàlisi.
ANTHROPIC_API_KEY=
# El model és configuració, no una decisió de domini.
LLM_MODEL=claude-sonnet-5
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_REQUIREMENTS_MAX_OUTPUT_TOKENS=8000
# Preu per model, en dòlars per milió de tokens, per posar un cost als
# benchmarks. Buit = no s'estima cap cost (els tokens es registren igualment).
# No es posa cap preu per defecte a propòsit: un preu desactualitzat dins del
# repositori és una xifra falsa que ningú no revisa. La clau pot ser un prefix
# del nom del model. Consulta el full de preus del proveïdor abans d'omplir-ho.
# LLM_MODEL_PRICES={"claude-sonnet-5": {"input": 0.0, "output": 0.0}}

# --- Benchmark d'extraccio -------------------------------------------------
# Base de dades PROPIA per als benchmarks, amb el seu corpus. Buida per defecte.
# El benchmark refusa `licitacions` i `licitacions_test`: mesurar no pot
# contaminar ni la base de desenvolupament ni la dels tests.
# BENCHMARK_DATABASE_URL=postgresql+asyncpg://usuari:contrasenya@127.0.0.1:5433/licitacions_benchmark
# Chunking per pàgines senceres, amb solapament per als requisits que travessen
# un salt de pàgina.
REQUIREMENTS_CHUNK_PAGES=6
REQUIREMENTS_CHUNK_OVERLAP_PAGES=1
REQUIREMENTS_MAX_PAGES_PER_RUN=400
REQUIREMENTS_MAX_QUOTE_CHARS=600
REQUIREMENTS_ANALYSIS_STALE_SECONDS=900
